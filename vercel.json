{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci",
  "buildCommand": "cd frontend && VITE_API_BASE=same-origin npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,docs/**,scripts/**,backend/tests/**,data/generator/**,**/node_modules/**,**/__pycache__/**}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}
