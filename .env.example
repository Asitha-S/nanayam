# Copy to .env (never commit .env). See PROJECT.md section 6.

# Each person uses their own key
SARVAM_API_KEY=

# cache_only: never call Sarvam (stage) | cache_first: cache, call on miss (dev) | live: always call (refresh demo cache)
DEMO_MODE=cache_first

# The backend's "today" (injectable clock, see backend/app/clock.py)
DEMO_DATE=2026-11-15

# SQLite file, relative to the repository root
DB_PATH=backend/naanayam.db

# Minimum AUTO threshold. Effective threshold = max(model artifact threshold, CONF_THRESHOLD)
CONF_THRESHOLD=0.90

# Enables /api/demo/* (reset, next-payment, script, tamper). false -> they return 404
ENABLE_DEMO_TOOLS=true

# Where new Sarvam responses are written: dev -> cache/sarvam_dev/ (gitignored), demo -> cache/sarvam_demo/ (committed).
# Reads always check cache/sarvam_demo/ first, then cache/sarvam_dev/.
SARVAM_CACHE_DIR=dev

# Your name, written into logs/sarvam_calls.jsonl so we can see who spent credits
SARVAM_PERSON=

# Optional, for tests only: override the cache root and logs folder
# SARVAM_CACHE_ROOT=cache
# LOGS_DIR=logs
# DEMO_SEED_DB=data/demo/seed.db
