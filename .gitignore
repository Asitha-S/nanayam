# Secrets: never commit .env (copy .env.example instead)
.env
frontend/.env
*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
build/
dist/

# Working database (recreated from data/demo/seed.db by /demo/reset)
backend/naanayam.db
backend/naanayam.db-*
*.db-wal
*.db-shm

# Generated data (data/demo/ IS committed, including seed.db)
data/generated/*
!data/generated/.gitkeep
data/eval/runs/

# Sarvam: dev cache is personal; demo cache IS committed
cache/sarvam_dev/
logs/

# Frontend
node_modules/
frontend/dist/
# Impeccable: catalogue images downloaded as a quality bar are third-party, not ours to commit
frontend/.impeccable/reference/
# UI sweep (npm run ui-check): screenshots and report, never committed
frontend/shots/
frontend/shots-before/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Vercel CLI: project link and pulled env files (VERCEL_OIDC_TOKEN)
.vercel
.env*.local
